// Schéma Darna — PostgreSQL (production-ready)
// Migration depuis SQLite : npx prisma migrate dev --name init
//
// Dev local rapide avec Docker :
//   docker run -d -p 5432:5432 \
//     -e POSTGRES_DB=darna \
//     -e POSTGRES_USER=darna \
//     -e POSTGRES_PASSWORD=darna \
//     --name darna-db postgres:16-alpine
//
// Puis dans .env :
//   DATABASE_URL="postgresql://darna:darna@localhost:5432/darna"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url : connexion applicative. En prod elle peut pointer un pooler
  //   (PgBouncer / Prisma Accelerate / pooler Supabase) via des paramètres
  //   d'URL : ?pgbouncer=true&connection_limit=10&pool_timeout=20 (cf. .env.example).
  // directUrl : connexion DIRECTE utilisée par `prisma migrate` / `db push` — le
  //   pooler en mode transaction ne supporte pas les requêtes du moteur de
  //   migration. En local/démo (pas de pooler) : DIRECT_URL = DATABASE_URL.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  image         String?  // Photo de profil — URL locale /uploads (cf. src/lib/uploads.ts)
  role          String   @default("VOYAGEUR") // VOYAGEUR | HOTE | AGENCE | ADMIN
  phoneVerified Boolean  @default(false)
  // PR5 — vérification e-mail distincte du KYC téléphonique.
  emailVerified Boolean  @default(false)
  kycStatus     String   @default("NON_VERIFIE") // NON_VERIFIE | EN_ATTENTE | VERIFIE | DEMO_VERIFIE
  // CIN saisie au KYC. Chiffrée au repos (AES-256-GCM) dès KYC_ENC_KEY défini ;
  // OBLIGATOIRE en KYC_MODE=production (boot fail-fast). Cf. src/lib/crypto.ts.
  cin           String?
  // Empreinte déterministe de la CIN (hashCin) — index UNIQUE : interdit deux
  // comptes avec la même CIN, sans exposer le numéro. Cf. src/lib/crypto.ts.
  cinHash       String?  @unique
  // PR2 — Wakil : agent vérifié sur le terrain.
  isWakil       Boolean  @default(false)
  // Pays de résidence déclaré à l'inscription (libellé FR, cf. PHONE_COUNTRIES) —
  // clé du pilotage diaspora (north-star marketing : cible France). Null tant
  // que non renseigné (comptes historiques ou inscription sans choix).
  country       String?
  createdAt     DateTime @default(now())

  properties         Property[]
  bookings           Booking[]
  reviews            Review[]
  contactRequests    ContactRequest[]
  favorites          Favorite[]
  favoriteFolders    FavoriteFolder[]
  auditLogs          AuditLog[]
  otpChallenges      OtpChallenge[]
  // PR1 — back-relation : annonces vérifiées par cet utilisateur (admin/wakil).
  verifiedProperties   Property[]          @relation("PropertyVerifiedBy")
  // PR2 — candidatures Wakil liées à ce compte.
  wakilApplications    WakilApplication[]
  // PR2 — candidatures Wakil revues par cet admin.
  reviewedApplications WakilApplication[]  @relation("WakilApplicationReviewer")
}

// Défi OTP de vérification KYC ou email : code haché (jamais en clair) + TTL +
// compteur de tentatives. Une seule challenge active par (userId, purpose).
// Cf. src/lib/otp.ts.
model OtpChallenge {
  id        String   @id @default(cuid())
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  // PR5 — "KYC" (vérification téléphone) | "EMAIL" (vérification e-mail)
  purpose   String   @default("KYC")
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Property {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  type        String // SEJOUR | LOCATION | VENTE
  // Verticale du produit (frontière de module + feature-flag). DÉRIVÉE de `type`
  // (SEJOUR→STAY ; LOCATION/VENTE→IMMO) et toujours renseignée à la création.
  // Distincte de `type` : permet le gating par verticale et un futur split
  // physique. Cf. src/lib/constants.ts (verticalOfType) et src/lib/modes.ts.
  vertical    String // STAY | IMMO
  status      String   @default("EN_ATTENTE_VALIDATION") // EN_ATTENTE_VALIDATION | ACTIVE | LOUE | VENDU | EXPIREE
  verified    Boolean  @default(false)
  verificationLevel String? // null | "REMOTE" | "ON_SITE"
  // PR1 — vérification admin/wakil : date et auteur de la vérification.
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("PropertyVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  // Prix en TND : nuitée (SEJOUR), loyer mensuel (LOCATION), prix total (VENTE)
  price       Int
  surface     Int?
  rooms       Int?
  maxGuests   Int?
  city        String
  gouvernorat String
  address     String?
  latitude    Float
  longitude   Float
  amenities   String   @default("") // libellés séparés par « | »
  publishedAt DateTime @default(now())
  expiresAt   DateTime
  // Mise en avant payante (« à la une ») : date de fin du boost, ou null.
  // L'annonce est à la une tant que featuredUntil > now ; le champ est remis
  // à null paresseusement une fois expiré (cf. clearExpiredFeatured()).
  featuredUntil DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  photos          Photo[]
  availabilities  Availability[]
  bookings        Booking[]
  reviews         Review[]
  contactRequests ContactRequest[]
  favorites       Favorite[]
  // Détails spécifiques par verticale (1:1, séparables physiquement). Vides
  // tant que les lectures ne sont pas branchées (cf. roadmap PR4/PR5).
  stay            StayDetails?
  immo            ImmoDetails?

  @@index([type, status, expiresAt])
  // Listing + gating par verticale (searchSejours/searchImmobilier, flags) :
  // index préfixé par `vertical` pour servir les requêtes filtrées par module.
  @@index([vertical, status, expiresAt])
  // Annonces actives requêtées SANS filtre de type (accueil getFeaturedListings,
  // sitemap, market) : l'index composite ci-dessus, préfixé par `type`, ne peut
  // pas les servir (PostgreSQL 16 n'a pas de skip-scan d'index).
  @@index([status, expiresAt])
  @@index([city])
  @@index([gouvernorat])
  @@index([ownerId])
  @@index([featuredUntil]) // tri « à la une » + purge paresseuse des boosts expirés
}

// Détails spécifiques à la verticale SÉJOUR (1:1 avec Property). Table séparée
// du noyau pour rendre un futur split physique trivial. Backfill + lecture
// branchés en PR4 (roadmap) ; vide à la création de la table.
model StayDetails {
  propertyId String   @id
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Capacité d'accueil (migrée depuis Property.maxGuests en PR4).
  maxGuests  Int
}

// Détails spécifiques à la verticale IMMO (1:1 avec Property). Écriture/lecture
// branchées en PR5 (roadmap) ; vide à la création de la table. JAMAIS de champ
// de paiement ici (invariant : l'immo n'a pas de transaction en ligne).
model ImmoDetails {
  propertyId    String   @id
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind          String // APPARTEMENT | MAISON | VILLA | STUDIO | BUREAU | LOCAL | TERRAIN
  condition     String? // NEUF | ANCIEN (null pour TERRAIN)
  floor         Int?
  furnished     Boolean  @default(false)
  charges       Int? // charges mensuelles (LOCATION)
  landBuildable Boolean? // terrain constructible
  dpe           String? // classe énergie (A..G)
}

model Photo {
  id       String  @id @default(cuid())
  url      String
  alt      String
  // Légende contextuelle facultative fournie par l'annonceur, affichée en
  // overlay dans la galerie immersive (« Séjour lumineux avec balcon »…).
  caption  String?
  position Int     @default(0)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Les photos sont toujours chargées par annonce et triées par position
  // (vignette take:1 des cartes + galerie de la page annonce). PostgreSQL
  // n'indexe pas les clés étrangères automatiquement → sans cet index, chaque
  // lecture de photos est un seq scan.
  @@index([propertyId, position])
}

// Période d'indisponibilité (bloquée par l'hôte) pour les séjours.
model Availability {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  // Note privée de l'hôte (ex. « séjour famille », « travaux ») — jamais
  // exposée aux voyageurs, aide-mémoire dans le dashboard uniquement.
  reason    String?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Booking {
  id           String    @id @default(cuid())
  checkIn      DateTime
  checkOut     DateTime
  guests       Int       @default(1)
  nightlyPrice Int  // TND, figé à la réservation
  serviceFee   Int  // TND, affiché au récapitulatif — zéro frais caché
  totalPrice   Int  // TND
  status       String    @default("EN_ATTENTE") // EN_ATTENTE | CONFIRMEE | ANNULEE | TERMINEE
  escrow       String    @default("AUCUN")      // AUCUN | EN_SEQUESTRE | LIBERE
  // true = confirmée via paiement SIMULÉ (PAYMENT_MODE=demo) : aucun argent réel
  // n'a transité. Permet de distinguer sans ambiguïté les réservations de démo.
  demo         Boolean   @default(false)
  // Référence du paiement Konnect (null tant que le paiement n'est pas initié).
  // Unique : sert de clé de réconciliation côté webhook. Null en mode mock.
  paymentRef   String?   @unique
  // Expiration des réservations EN_ATTENTE (15 min après création)
  // Null une fois la réservation CONFIRMEE.
  expiresAt    DateTime?
  // Date de règlement : posée quand le paiement est confirmé (fonds sous
  // séquestre). Null tant que la réservation n'est pas payée.
  paidAt       DateTime?
  createdAt    DateTime  @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestId    String
  guest      User     @relation(fields: [guestId], references: [id], onDelete: Cascade)

  review Review?

  @@index([propertyId, status])
  @@index([guestId])
  @@index([status, expiresAt]) // Pour le cleanup des EN_ATTENTE expirées
}

// Un avis sans réservation est impossible au niveau du schéma :
// bookingId est obligatoire et unique (un seul avis par séjour).
model Review {
  id        String   @id @default(cuid())
  rating    Int // 1 à 5
  comment   String
  createdAt DateTime @default(now())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String
  createdAt DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([propertyId])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Dossier de classement (null = « Sans dossier »). Supprimer un dossier
  // déclasse ses favoris sans les supprimer (onDelete: SetNull).
  folderId   String?
  folder     FavoriteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, propertyId])
  @@index([folderId])
}

// Dossier de favoris d'un utilisateur (« Monastir, Juin 2026 »…).
// Le nom par défaut suggéré est « Ville, Mois Année » mais reste librement
// modifiable par l'utilisateur à la création.
model FavoriteFolder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  favorites Favorite[]

  @@index([userId])
}

model WakilApplication {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  city       String
  motivation String
  status     String   @default("RECUE") // RECUE | ENTRETIEN | ACCEPTEE | REFUSEE
  createdAt  DateTime @default(now())
  // PR2 — lien vers le compte utilisateur (null si candidature anonyme).
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // PR2 — revue par un admin.
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?    @relation("WakilApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  interviewAt   DateTime?
  deletedAt     DateTime?

  @@index([userId])
  @@index([deletedAt])
}

/**
 * Audit trail — chaque événement sensible (login, booking, paiement…)
 * est enregistré avec userId, IP et métadonnées JSON.
 * Rétention recommandée en production : 90 jours minimum (RGPD).
 */
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // voir AuditAction dans src/lib/audit.ts
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip        String?
  metadata  String   @default("{}") // JSON stringifié
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action, createdAt])
  @@index([createdAt]) // Pour les purges de rétention
}
