// Schéma Darna — PostgreSQL (production-ready)
// Migration depuis SQLite : npx prisma migrate dev --name init
//
// Dev local rapide avec Docker :
//   docker run -d -p 5432:5432 \
//     -e POSTGRES_DB=darna \
//     -e POSTGRES_USER=darna \
//     -e POSTGRES_PASSWORD=darna \
//     --name darna-db postgres:16-alpine
//
// Puis dans .env :
//   DATABASE_URL="postgresql://darna:darna@localhost:5432/darna"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url : connexion applicative. En prod elle peut pointer un pooler
  //   (PgBouncer / Prisma Accelerate / pooler Supabase) via des paramètres
  //   d'URL : ?pgbouncer=true&connection_limit=10&pool_timeout=20 (cf. .env.example).
  // directUrl : connexion DIRECTE utilisée par `prisma migrate` / `db push` — le
  //   pooler en mode transaction ne supporte pas les requêtes du moteur de
  //   migration. En local/démo (pas de pooler) : DIRECT_URL = DATABASE_URL.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String
  phone         String?
  image         String?  // Photo de profil — URL locale /uploads (cf. src/lib/uploads.ts)
  role          String   @default("VOYAGEUR") // VOYAGEUR | HOTE | AGENCE | ADMIN
  phoneVerified Boolean  @default(false)
  // PR5 — vérification e-mail distincte du KYC téléphonique.
  emailVerified Boolean  @default(false)
  kycStatus     String   @default("NON_VERIFIE") // NON_VERIFIE | EN_ATTENTE | VERIFIE | DEMO_VERIFIE
  // CIN saisie au KYC. Chiffrée au repos (AES-256-GCM) dès KYC_ENC_KEY défini ;
  // OBLIGATOIRE en KYC_MODE=production (boot fail-fast). Cf. src/lib/crypto.ts.
  cin           String?
  // Empreinte déterministe de la CIN (hashCin) — index UNIQUE : interdit deux
  // comptes avec la même CIN, sans exposer le numéro. Cf. src/lib/crypto.ts.
  cinHash       String?  @unique
  // PR2 — Wakil : agent vérifié sur le terrain.
  isWakil       Boolean  @default(false)
  // Incrémenté à chaque changement de mot de passe : invalide les JWT précédents.
  tokenVersion  Int      @default(0)
  // Suspension anti-bypass : posée quand l'utilisateur dépasse le seuil de
  // tentatives de partage de coordonnées hors plateforme (cf. messages). Un
  // compte suspendu ne peut plus réserver ni envoyer de messages ; un admin
  // peut le réactiver. Cf. MESSAGE_FLAG_SUSPENSION_THRESHOLD.
  suspended     Boolean  @default(false)
  suspendedAt   DateTime?
  // Suspension PROGRESSIVE : `suspendedUntil` = fin de la suspension temporaire
  // (null + suspended=true = suspension indéfinie, levée par un admin).
  // `suspensionCount` = nombre de suspensions subies → palier de durée croissant
  // (cf. SUSPENSION_DURATIONS_DAYS). Une suspension est ACTIVE si suspended ET
  // (suspendedUntil null OU suspendedUntil > now) — cf. src/lib/suspension.ts.
  suspendedUntil  DateTime?
  suspensionCount Int       @default(0)
  // Motif de la DERNIÈRE suspension (MESSAGE_BYPASS | BOOKING_NO_SHOW |
  // HOST_CANCELLED_BOOKING, cf. SuspensionReason dans src/lib/suspension.ts) —
  // permet au bandeau « Pourquoi ? » (dashboard/layout.tsx) d'expliquer la
  // VRAIE raison plutôt qu'un texte générique. Null = jamais suspendu, ou
  // suspendu avant l'introduction de ce champ (bascule sur le texte legacy).
  suspensionReason String?
  // Pays de résidence déclaré à l'inscription (libellé FR, cf. PHONE_COUNTRIES) —
  // clé du pilotage diaspora (north-star marketing : cible France). Null tant
  // que non renseigné (comptes historiques ou inscription sans choix).
  country       String?
  createdAt     DateTime @default(now())

  properties           Property[]
  bookings             Booking[]
  messages             Message[]
  reviews              Review[]
  // Avis « hôte → voyageur » (F1) : reçus par ce voyageur / rédigés par cet hôte.
  guestReviewsReceived GuestReview[] @relation("GuestReviewTarget")
  guestReviewsAuthored GuestReview[] @relation("GuestReviewAuthor")
  contactRequests      ContactRequest[]
  favorites          Favorite[]
  favoriteFolders    FavoriteFolder[]
  auditLogs          AuditLog[]
  otpChallenges      OtpChallenge[]
  passwordResetTokens PasswordResetToken[]
  // Centre de notifications in-app (F9) : réservation confirmée/annulée, avis
  // reçu, annonce bientôt expirée.
  notifications      Notification[]
  // Alertes de recherche sauvegardée (F7) : ville + budget.
  savedSearches      SavedSearch[]
  // PR1 — back-relation : annonces vérifiées par cet utilisateur (admin/wakil).
  verifiedProperties   Property[]          @relation("PropertyVerifiedBy")
  // PR2 — candidatures Wakil liées à ce compte.
  wakilApplications    WakilApplication[]
  // PR2 — candidatures Wakil revues par cet admin.
  reviewedApplications WakilApplication[]  @relation("WakilApplicationReviewer")
  // Rail 2 (PAIEMENT_SUR_PLACE_ROADMAP.md) : factures de commission dues par
  // cet utilisateur en tant qu'hôte de réservations SUR_PLACE.
  hostInvoices HostInvoice[]
}

// Défi OTP de vérification KYC ou email : code haché (jamais en clair) + TTL +
// compteur de tentatives. Une seule challenge active par (userId, purpose).
// Cf. src/lib/otp.ts.
model OtpChallenge {
  id        String   @id @default(cuid())
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  // PR5 — "KYC" (vérification téléphone) | "EMAIL" (vérification e-mail)
  purpose   String   @default("KYC")
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// Jeton de réinitialisation de mot de passe : token aléatoire haché (jamais en
// clair), TTL court, usage unique (supprimé à la consommation). Une seule
// demande active par utilisateur (les précédentes sont purgées à l'émission).
// Flux 100 % démo-compatible : sans provider e-mail réel, le lien est affiché
// à l'écran (cf. src/actions/auth.ts) ; bascule prod = EMAIL_PROVIDER=resend.
// Cf. src/lib/reset-token.ts.
model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Property {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  type        String // SEJOUR | LOCATION | VENTE
  // Verticale du produit (frontière de module + feature-flag). DÉRIVÉE de `type`
  // (SEJOUR→STAY ; LOCATION/VENTE→IMMO) et toujours renseignée à la création.
  // Distincte de `type` : permet le gating par verticale et un futur split
  // physique. Cf. src/lib/constants.ts (verticalOfType) et src/lib/modes.ts.
  vertical    String // STAY | IMMO
  status      String   @default("EN_ATTENTE_VALIDATION") // EN_ATTENTE_VALIDATION | ACTIVE | LOUE | VENDU | EXPIREE
  verified    Boolean  @default(false)
  verificationLevel String? // null | "REMOTE" | "ON_SITE"
  // PR1 — vérification admin/wakil : date et auteur de la vérification.
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("PropertyVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  // Prix en TND : nuitée (SEJOUR), loyer mensuel (LOCATION), prix total (VENTE)
  price       Int
  // Agrégats d'avis DÉNORMALISÉS (maintenus à chaque avis, cf. submitReviewAction
  // + seed). Servent le tri « mieux/moins notés » : Prisma ne sait pas trier par
  // moyenne d'une relation (et le projet s'interdit le SQL brut), d'où ce cache.
  // ratingAvg null = aucun avis → relégué en fin de tri (nulls: "last").
  ratingAvg   Float?
  ratingCount Int      @default(0)
  surface     Int?
  rooms       Int?
  maxGuests   Int?
  city        String
  gouvernorat String
  address     String?
  latitude    Float
  longitude   Float
  amenities   String   @default("") // libellés séparés par « | »
  publishedAt DateTime @default(now())
  expiresAt   DateTime
  // Mise en avant payante (« à la une ») : date de fin du boost, ou null.
  // L'annonce est à la une tant que featuredUntil > now ; le champ est remis
  // à null paresseusement une fois expiré (cf. clearExpiredFeatured()).
  featuredUntil DateTime?
  cancelPolicy  String   @default("MODEREE") // FLEXIBLE | MODEREE | STRICTE
  // Paiement sur place (Rail 2, PAIEMENT_SUR_PLACE_ROADMAP.md) : opt-in HÔTE,
  // annonce SEJOUR uniquement. `cashTermsAcceptedAt` = horodatage d'acceptation
  // des CGU hôte dédiées, posé SERVEUR uniquement à l'activation (jamais confiance
  // au client) — null tant que jamais activé.
  cashPaymentEnabled   Boolean   @default(false)
  cashTermsAcceptedAt  DateTime?
  // Annulation hôte (ANNULATION_HOTE_ROADMAP.md) : date de fin du blocage
  // temporaire de l'annonce suite à une annulation par l'hôte (null = pas
  // bloquée). Même esprit que `expiresAt` : filtre paresseux sur une date,
  // jamais de statut à faire basculer par un job.
  cancelBlockedUntil   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  photos          Photo[]
  availabilities  Availability[]
  bookings        Booking[]
  reviews         Review[]
  contactRequests ContactRequest[]
  favorites       Favorite[]
  // Détails spécifiques par verticale (1:1, séparables physiquement). Vides
  // tant que les lectures ne sont pas branchées (cf. roadmap PR4/PR5).
  stay            StayDetails?
  immo            ImmoDetails?

  @@index([type, status, expiresAt])
  // Listing + gating par verticale (searchSejours/searchImmobilier, flags) :
  // index préfixé par `vertical` pour servir les requêtes filtrées par module.
  @@index([vertical, status, expiresAt])
  // Annonces actives requêtées SANS filtre de type (accueil getFeaturedListings,
  // sitemap, market) : l'index composite ci-dessus, préfixé par `type`, ne peut
  // pas les servir (PostgreSQL 16 n'a pas de skip-scan d'index).
  @@index([status, expiresAt])
  @@index([city])
  @@index([gouvernorat])
  @@index([ownerId])
  @@index([featuredUntil]) // tri « à la une » + purge paresseuse des boosts expirés
}

// Détails spécifiques à la verticale SÉJOUR (1:1 avec Property). Table séparée
// du noyau pour rendre un futur split physique trivial. Backfill + lecture
// branchés en PR4 (roadmap) ; vide à la création de la table.
model StayDetails {
  propertyId String   @id
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Capacité d'accueil (migrée depuis Property.maxGuests en PR4).
  maxGuests  Int
  // Type de bien (F5 roadmap) : libellé FR stocké tel quel (cf. AMENITIES).
  kind       String
}

// Détails spécifiques à la verticale IMMO (1:1 avec Property). Écriture/lecture
// branchées en PR5 (roadmap) ; vide à la création de la table. JAMAIS de champ
// de paiement ici (invariant : l'immo n'a pas de transaction en ligne).
model ImmoDetails {
  propertyId    String   @id
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  kind          String // APPARTEMENT | MAISON | VILLA | STUDIO | BUREAU | LOCAL | TERRAIN
  condition     String? // NEUF | ANCIEN (null pour TERRAIN)
  floor         Int?
  furnished     Boolean  @default(false)
  charges       Int? // charges mensuelles (LOCATION)
  landBuildable Boolean? // terrain constructible
  dpe           String? // classe énergie (A..G)
}

model Photo {
  id       String  @id @default(cuid())
  url      String
  alt      String
  // Légende contextuelle facultative fournie par l'annonceur, affichée en
  // overlay dans la galerie immersive (« Séjour lumineux avec balcon »…).
  caption  String?
  position Int     @default(0)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Les photos sont toujours chargées par annonce et triées par position
  // (vignette take:1 des cartes + galerie de la page annonce). PostgreSQL
  // n'indexe pas les clés étrangères automatiquement → sans cet index, chaque
  // lecture de photos est un seq scan.
  @@index([propertyId, position])
}

// Période d'indisponibilité (bloquée par l'hôte) pour les séjours.
model Availability {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  // Note privée de l'hôte (ex. « séjour famille », « travaux ») — jamais
  // exposée aux voyageurs, aide-mémoire dans le dashboard uniquement.
  reason    String?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Booking {
  id           String    @id @default(cuid())
  checkIn      DateTime
  checkOut     DateTime
  guests       Int       @default(1)
  nightlyPrice Int  // TND, figé à la réservation
  serviceFee   Int  // TND, affiché au récapitulatif — zéro frais caché
  totalPrice   Int  // TND
  // Gating acompte (anti-bypass) : acompte MINIMUM dû en ligne, figé à la
  // création = max(10 % du total, commission Darna) et ≤ total. La commission
  // Darna y est entièrement contenue (revenu garanti). Cf. computeDepositAmount.
  depositAmount Int      @default(0)
  // Montant RÉELLEMENT choisi par le voyageur puis encaissé (entre depositAmount
  // et totalPrice). Posé à l'init du paiement → source de vérité serveur pour la
  // vérif du montant reçu (settleKonnectBooking). Solde dû en cash à l'arrivée =
  // totalPrice - amountPaid (jamais stocké, toujours recalculé).
  amountPaid    Int      @default(0)
  status       String    @default("EN_ATTENTE") // EN_ATTENTE | CONFIRMEE | ANNULEE | TERMINEE
  escrow       String    @default("AUCUN")      // AUCUN | EN_SEQUESTRE | LIBERE
  // Rail de paiement (PAIEMENT_SUR_PLACE_ROADMAP.md) : ESCROW (défaut, séquestre
  // Konnect, comportement actuel inchangé) | SUR_PLACE (Rail 2 — zéro paiement en
  // ligne, acceptation hôte requise, commission facturée après coup via HostInvoice).
  paymentMode  String    @default("ESCROW")
  // true = confirmée via paiement SIMULÉ (PAYMENT_MODE=demo) : aucun argent réel
  // n'a transité. Permet de distinguer sans ambiguïté les réservations de démo.
  demo         Boolean   @default(false)
  // Référence du paiement Konnect (null tant que le paiement n'est pas initié).
  // Unique : sert de clé de réconciliation côté webhook. Null en mode mock.
  paymentRef   String?   @unique
  // Expiration des réservations EN_ATTENTE (15 min après création)
  // Null une fois la réservation CONFIRMEE.
  expiresAt    DateTime?
  // Date de règlement : posée quand le paiement est confirmé (fonds sous
  // séquestre). Null tant que la réservation n'est pas payée.
  paidAt        DateTime?
  // Annulation : date + montant remboursable figé au moment de l'annulation.
  cancelledAt   DateTime?
  refundAmount  Int?      // TND ; null si non annulée ou politique 0 %
  // Annulation À L'INITIATIVE DE L'HÔTE (ANNULATION_HOTE_ROADMAP.md), distincte
  // d'une annulation voyageur (cancelBookingAction) : posée UNIQUEMENT par
  // hostCancelBookingAction, jamais par le voyageur. Remboursement TOUJOURS
  // intégral dans ce cas (cf. refundAmount = totalPrice), et hostCancelBlockDays
  // trace le palier de blocage d'annonce appliqué (indépendant d'un futur
  // changement du barème).
  cancelledByHostAt   DateTime?
  hostCancelBlockDays Int?
  // Geste commercial (ANNULATION_HOTE_ROADMAP.md §AH4) : id de la NOUVELLE
  // réservation pour laquelle le voyageur a consommé la réduction ponctuelle
  // liée à CETTE annulation (token signé, cf. src/lib/rebooking-discount.ts).
  // Null tant que non utilisée. Posée UNE SEULE FOIS (condition d'unicité
  // appliquée par l'updateMany qui la consomme) — usage unique garanti.
  rebookingDiscountUsedFor String?
  createdAt    DateTime  @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestId    String
  guest      User     @relation(fields: [guestId], references: [id], onDelete: Cascade)

  review      Review?
  guestReview GuestReview?
  messages    Message[]
  hostInvoice HostInvoice?

  @@index([propertyId, status])
  @@index([guestId])
  @@index([status, expiresAt]) // Pour le cleanup des EN_ATTENTE expirées
}

// Facturation a posteriori de la commission Darna à l'hôte (Rail 2, cf.
// PAIEMENT_SUR_PLACE_ROADMAP.md) : une réservation SUR_PLACE ne fait transiter
// aucun argent par Konnect à la réservation, donc la commission (= le
// `serviceFee` de la réservation, copié ici au moment de la génération) est
// recouvrée après coup auprès de l'hôte, réglée via un lien de paiement Konnect
// ponctuel (mirroring settleKonnectBooking, cf. src/lib/payments.ts).
//
// VOLONTAIREMENT pas de statut "EN_RETARD" stocké : le retard est un DÉRIVÉ
// (status="EN_ATTENTE" && dueAt < now), jamais persisté ni recalculé par un
// job — même esprit que Property.expiresAt, qui n'a pas besoin qu'un cron
// bascule un statut à l'expiration. Cf. PSP6 (masquage d'annonces) et PSP5
// (rappels), tous deux calculés à la lecture, pas de cron.
model HostInvoice {
  id        String    @id @default(cuid())
  amount    Int       // TND — copié de Booking.serviceFee à la génération
  status    String    @default("EN_ATTENTE") // EN_ATTENTE | PAYEE
  // Référence du paiement Konnect réglant CETTE facture (distincte du
  // paymentRef de la réservation elle-même, qui reste toujours null en mode
  // SUR_PLACE). Unique : clé de réconciliation du webhook dédié.
  paymentRef String?  @unique
  dueAt      DateTime
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  // Dernière relance MANUELLE envoyée par un admin (dashboard §PSP8) — permet
  // d'afficher "Relancé le X" plutôt qu'un clic sans retour visible. Distinct
  // des futures relances automatiques (§PSP5), pas encore implémentées.
  lastReminderAt DateTime?

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hostId    String
  host      User    @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId, status])
  @@index([status, dueAt])
}

// Messagerie interne Darna, attachée à une réservation (Phase 2 anti-bypass).
// Permet à l'hôte et au voyageur de coordonner AVANT la révélation du contact
// direct (cf. contactRevealState), sans échanger de PII : `body` est scanné et
// les numéros/e-mails sont masqués à l'écriture (cf. src/lib/message-scan.ts).
// `flagged` = true quand des coordonnées ont été détectées et masquées.
model Message {
  id        String   @id @default(cuid())
  body      String
  flagged   Boolean  @default(false)
  // Lu/non lu : posé quand le DESTINATAIRE (l'autre participant de la
  // réservation, jamais l'auteur) ouvre le fil. Null = non lu → alimente le
  // compteur de la pastille « Messagerie » et la notification. Le fil n'a que
  // deux parties, donc un seul horodatage par message suffit.
  readAt    DateTime?
  createdAt DateTime @default(now())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  // Compteur de non-lus par destinataire (senderId ≠ moi, readAt null).
  @@index([senderId, readAt])
}

// Un avis sans réservation est impossible au niveau du schéma :
// bookingId est obligatoire et unique (un seul avis par séjour).
model Review {
  id        String   @id @default(cuid())
  rating    Int // 1 à 5 — moyenne arrondie des 4 sous-notes ci-dessous
  comment   String
  createdAt DateTime @default(now())

  // Sous-notes (F2 roadmap), 1 à 5 chacune. `rating` reste la moyenne arrondie,
  // calculée serveur (submitReviewAction) — jamais saisie séparément par le
  // voyageur, pour éviter toute incohérence entre note globale et détail.
  proprete      Int
  communication Int
  conformite    Int
  qualitePrix   Int

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// Avis symétrique « hôte → voyageur » (F1 roadmap) : note le COMPORTEMENT du
// voyageur, distinct de Review (voyageur → annonce). Modèle séparé plutôt
// qu'un flag sur Review : auteur/cible inversés (User↔User, pas User↔Property)
// et cycle de vie indépendant — un avis n'implique jamais l'autre. Un seul
// avis hôte par réservation (bookingId @unique), publié par le PROPRIÉTAIRE
// de l'annonce concernée (vérifié côté action, cf. submitGuestReviewAction).
model GuestReview {
  id        String   @id @default(cuid())
  rating    Int // 1 à 5
  comment   String
  createdAt DateTime @default(now())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  targetId String // voyageur noté
  target   User   @relation("GuestReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  authorId String // hôte auteur
  author   User   @relation("GuestReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([targetId])
}

// Centre de notifications in-app (F9) : générique, au-delà de la messagerie
// (déjà gérée par MessagesNotifier/countUnreadMessages). Le texte affiché
// n'est JAMAIS figé en base (convention i18n du projet) : seul `propertyTitle`
// est stocké, le libellé complet est composé à l'affichage via le dictionnaire
// de la locale courante (cf. src/lib/notification-text.ts).
model Notification {
  id            String    @id @default(cuid())
  type          String // RESERVATION_CONFIRMEE | RESERVATION_ANNULEE | AVIS_RECU | AVIS_HOTE_RECU | ANNONCE_EXPIRE_BIENTOT | ALERTE_NOUVELLE_ANNONCE
  propertyTitle String?
  href          String?
  readAt        DateTime?
  createdAt     DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  // NB : un index UNIQUE PARTIEL supplémentaire existe en base — (userId, href)
  // WHERE type = 'ANNONCE_EXPIRE_BIENTOT' — pour dédoublonner les alertes
  // d'expiration sous requêtes concurrentes. Non représentable dans le DSL
  // Prisma (pas de clause WHERE sur @@unique) ; ajouté à la main dans la
  // migration 20260702170000_add_notification. Ne PAS le supprimer via
  // `migrate dev` sans le recréer manuellement (cf. src/lib/notification-center.ts).
}

// Alerte de recherche sauvegardée (F7) : ville + fourchette de prix. Un
// voyageur est alerté (in-app + e-mail) dès qu'une annonce séjour correspondante
// devient active — déclenché à l'événement (verifyPropertyAction), PAS par
// cron (cf. src/lib/saved-search.ts). Volontairement SANS dates : une annonce
// tout juste publiée n'a quasiment jamais de réservation existante, donc le
// filtre dates d'une recherche n'apporterait rien à ce stade (il reste
// pertinent pour la recherche live sur /sejours, pas pour cette alerte).
model SavedSearch {
  id        String   @id @default(cuid())
  city      String
  prixMin   Int?
  prixMax   Int?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, city, prixMin, prixMax])
  @@index([city])
}

model ContactRequest {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String
  createdAt DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  senderId   String?
  sender     User?    @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([propertyId])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // Dossier de classement (null = « Sans dossier »). Supprimer un dossier
  // déclasse ses favoris sans les supprimer (onDelete: SetNull).
  folderId   String?
  folder     FavoriteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, propertyId])
  @@index([folderId])
}

// Dossier de favoris d'un utilisateur (« Monastir, Juin 2026 »…).
// Le nom par défaut suggéré est « Ville, Mois Année » mais reste librement
// modifiable par l'utilisateur à la création.
model FavoriteFolder {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  favorites Favorite[]

  @@index([userId])
}

model WakilApplication {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String
  city       String
  motivation String
  status     String   @default("RECUE") // RECUE | ENTRETIEN | ACCEPTEE | REFUSEE
  createdAt  DateTime @default(now())
  // PR2 — lien vers le compte utilisateur (null si candidature anonyme).
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // PR2 — revue par un admin.
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?    @relation("WakilApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  interviewAt   DateTime?
  deletedAt     DateTime?

  @@index([userId])
  @@index([deletedAt])
}

/**
 * Audit trail — chaque événement sensible (login, booking, paiement…)
 * est enregistré avec userId, IP et métadonnées JSON.
 * Rétention recommandée en production : 90 jours minimum (RGPD).
 */
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // voir AuditAction dans src/lib/audit.ts
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip        String?
  metadata  String   @default("{}") // JSON stringifié
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action, createdAt])
  @@index([createdAt]) // Pour les purges de rétention
}
