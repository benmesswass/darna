# Copier ce fichier vers `.env` puis ajuster si besoin.

# Base SQLite locale (Prisma)
DATABASE_URL="file:./dev.db"

# Secret de session NextAuth — générer avec : openssl rand -base64 32
AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire"

# URL canonique du site (SEO, sitemap)
SITE_URL="http://localhost:3000"
