# Copier ce fichier vers `.env` puis ajuster les valeurs.
# ⚠️  NE JAMAIS COMMITER `.env` — ce fichier doit rester dans .gitignore.

# ────────────────────────────────────────────────
# BASE DE DONNÉES — PostgreSQL (production-ready)
# ────────────────────────────────────────────────
# Dev local avec Docker :
#   docker run -d -p 5432:5432 \
#     -e POSTGRES_DB=darna -e POSTGRES_USER=darna -e POSTGRES_PASSWORD=darna \
#     --name darna-db postgres:16-alpine
DATABASE_URL="postgresql://darna:darna@localhost:5432/darna"

# Connexion DIRECTE utilisée par `prisma migrate` / `db push`. En local/démo
# (pas de pooler) elle est égale à DATABASE_URL — l'expansion ci-dessous suffit :
DIRECT_URL="${DATABASE_URL}"

# Production (Supabase / Railway / Neon / RDS) :
# Faire pointer DATABASE_URL sur le POOLER (PgBouncer en mode transaction) et
# dimensionner le pool via les paramètres d'URL ; DIRECT_URL pointe la connexion
# directe (port 5432) pour les migrations.
#   DATABASE_URL="postgresql://user:pwd@pooler-host:6543/darna?pgbouncer=true&connection_limit=10&pool_timeout=20&sslmode=require"
#   DIRECT_URL="postgresql://user:pwd@db-host:5432/darna?sslmode=require"

# ────────────────────────────────────────────────
# NEXTAUTH — Secret de session JWT
# ────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
# ⚠️  Ne JAMAIS réutiliser entre environnements (dev ≠ staging ≠ prod)
AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire-openssl-rand-base64-32"

# ────────────────────────────────────────────────
# SITE — URL canonique (SEO, sitemap, HSTS)
# ────────────────────────────────────────────────
SITE_URL="https://darna.tn"
# Dev local :
# SITE_URL="http://localhost:3000"

# ════════════════════════════════════════════════
# MODES DÉMO ↔ PRODUCTION (cf. src/lib/modes.ts)
# ════════════════════════════════════════════════
# Tous les modes ont un défaut DÉMO sûr : l'app démarre sans aucune clé.
# Chaque mode réel exige sa config complète, VALIDÉE AU BOOT (fail-fast) — il
# est donc impossible d'activer une demi-prod par erreur.
#
#   PAYMENT_MODE = "demo" (séquestre simulé, défaut) | "konnect" (paiement réel)
#   KYC_MODE     = "demo" (OTP affiché, statut DEMO_VERIFIE, défaut) | "production"
#   STORAGE_MODE = "local" (disque, défaut) | "s3"
#
# DÉMO (réglages par défaut, rien à poser) :
# PAYMENT_MODE="demo"
# KYC_MODE="demo"
# STORAGE_MODE="local"

# ────────────────────────────────────────────────
# PROXY — Trust du header IP (rate limiting)
# ────────────────────────────────────────────────
# Passer à "true" uniquement si le serveur est derrière un proxy de confiance
# (Vercel, Cloudflare, Nginx) qui pose x-real-ip correctement.
# ⚠️  En PRODUCTION RÉELLE (un mode réel actif ci-dessus), "true" est OBLIGATOIRE :
#     le boot échoue sinon (sans proxy, le rate limiting retombe sur un bucket
#     global « untrusted » → lockout de toute la plateforme).
# En dev local et en démo, laisser à "false".
TRUSTED_PROXY="false"

# ────────────────────────────────────────────────
# REDIS — Cache + rate limiting distribués (OPTIONNEL)
# ────────────────────────────────────────────────
# Absent ⇒ fallback in-memory mono-instance (OK démo / serveur unique).
# À définir en prod multi-instance (Upstash, Railway, Redis managé…) pour un
# rate limiting et un cache partagés entre toutes les instances.
# REDIS_URL="rediss://default:password@host:6379"
# Dev local avec Docker :
#   docker run -d -p 6379:6379 --name darna-redis redis:7-alpine
# REDIS_URL="redis://localhost:6379"

# ────────────────────────────────────────────────
# STOCKAGE IMAGES — local (défaut) ou S3/R2
# ────────────────────────────────────────────────
# STORAGE_MODE="local" par défaut (uploads sur /public/uploads, serveur
# persistant requis — NE convient PAS au multi-instance/serverless).
# Passer à "s3" pour Cloudflare R2 / AWS S3 / MinIO — les 4 premières variables
# deviennent alors OBLIGATOIRES (boot fail-fast).
# (Rétro-compat : l'ancien STORAGE_DRIVER="s3" reste reconnu.)
# STORAGE_MODE="s3"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_BUCKET="darna-uploads"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_REGION="auto"                       # "auto" pour R2 ; ex. "eu-west-1" pour AWS
# S3_PUBLIC_URL="https://cdn.darna.tn"   # base publique de service (déf. : endpoint/bucket)

# ────────────────────────────────────────────────
# KYC — Vérification d'identité
# ────────────────────────────────────────────────
# KYC_MODE="demo" (défaut) : OTP affiché à l'écran, aucun SMS, statut DEMO_VERIFIE
#   (badge « démo » distinct, jamais confondu avec une vérification réelle).
# KYC_MODE="production" : exige (boot fail-fast) KYC_ENC_KEY + SMS_PROVIDER, ne
#   retourne JAMAIS le code au client, statut VERIFIE réservé au workflow SMS réel.
# KYC_MODE="production"
#
# Chiffrement AES-256-GCM de la CIN au repos. Générer : openssl rand -hex 32.
# Absent en démo → CIN en clair (CIN de démo). OBLIGATOIRE dès KYC_MODE=production.
# KYC_ENC_KEY="..."
#
# Provider SMS réel (à brancher dans src/lib/sms.ts). Requis dès KYC_MODE=production.
# SMS_PROVIDER="twilio"

# ────────────────────────────────────────────────
# OBSERVABILITÉ — Capture des erreurs (OPTIONNEL)
# ────────────────────────────────────────────────
# Les erreurs serveur sont TOUJOURS loggées en JSON structuré (stdout, captées
# par onRequestError). Si défini, elles sont aussi POSTées vers cet endpoint
# (relais Sentry, Slack, Logtail HTTP…). Absent → log seul.
# OBSERVABILITY_WEBHOOK_URL="https://..."

# ────────────────────────────────────────────────
# KONNECT — Paiement & séquestre
# ────────────────────────────────────────────────
# Sandbox gratuit, sans entité : https://dashboard.sandbox.konnect.network
# Récupérer dans le dashboard : la clé API (x-api-key) + le receiverWalletId.
#
# ⚠️  Le paiement réel ne s'active QU'AVEC PAYMENT_MODE="konnect" (cf. section
#     MODES) — la simple présence des clés ne suffit plus (anti-activation
#     accidentelle d'un paiement réel). En PAYMENT_MODE=konnect, ces deux
#     variables sont OBLIGATOIRES (boot fail-fast).
# PAYMENT_MODE="konnect"
# KONNECT_API_KEY="ta_cle_x_api_key"
# KONNECT_RECEIVER_WALLET_ID="ton_receiver_wallet_id"
#
# URL de l'API — sandbox par défaut. Production : https://api.konnect.network/api/v2
# KONNECT_API_URL="https://api.sandbox.konnect.network/api/v2"
#
# ⚠️  Le webhook Konnect appelle SITE_URL/api/payments/konnect/webhook : en dev
#     local, Konnect ne joint pas http://localhost — la page de retour
#     ?konnect=success règle le paiement en filet de sécurité. En prod, exposer
#     un SITE_URL public en HTTPS.
