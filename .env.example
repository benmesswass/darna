# Copier ce fichier vers `.env` puis ajuster les valeurs.
# ⚠️  NE JAMAIS COMMITER `.env` — ce fichier doit rester dans .gitignore.

# ────────────────────────────────────────────────
# BASE DE DONNÉES — PostgreSQL (production-ready)
# ────────────────────────────────────────────────
# Dev local avec Docker :
#   docker run -d -p 5432:5432 \
#     -e POSTGRES_DB=darna -e POSTGRES_USER=darna -e POSTGRES_PASSWORD=darna \
#     --name darna-db postgres:16-alpine
DATABASE_URL="postgresql://darna:darna@localhost:5432/darna"

# Connexion DIRECTE utilisée par `prisma migrate` / `db push`. En local/démo
# (pas de pooler) elle est égale à DATABASE_URL — l'expansion ci-dessous suffit :
DIRECT_URL="${DATABASE_URL}"

# Production (Supabase / Railway / Neon / RDS) :
# Faire pointer DATABASE_URL sur le POOLER (PgBouncer en mode transaction) et
# dimensionner le pool via les paramètres d'URL ; DIRECT_URL pointe la connexion
# directe (port 5432) pour les migrations.
#   DATABASE_URL="postgresql://user:pwd@pooler-host:6543/darna?pgbouncer=true&connection_limit=10&pool_timeout=20&sslmode=require"
#   DIRECT_URL="postgresql://user:pwd@db-host:5432/darna?sslmode=require"

# ────────────────────────────────────────────────
# NEXTAUTH — Secret de session JWT
# ────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
# ⚠️  Ne JAMAIS réutiliser entre environnements (dev ≠ staging ≠ prod)
AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire-openssl-rand-base64-32"

# ────────────────────────────────────────────────
# SITE — URL canonique (SEO, sitemap, HSTS)
# ────────────────────────────────────────────────
SITE_URL="https://darna.tn"
# Dev local :
# SITE_URL="http://localhost:3000"

# ────────────────────────────────────────────────
# PROXY — Trust du header IP
# ────────────────────────────────────────────────
# Passer à "true" uniquement si le serveur est derrière un proxy de confiance
# (Vercel, Cloudflare, Nginx) qui pose x-real-ip correctement.
# En dev local, laisser à "false".
TRUSTED_PROXY="false"

# ────────────────────────────────────────────────
# KONNECT — Paiement & séquestre (OPTIONNEL)
# ────────────────────────────────────────────────
# Sandbox gratuit, sans entité : https://dashboard.sandbox.konnect.network
# Récupérer dans le dashboard : la clé API (x-api-key) + le receiverWalletId.
#
# ⚠️  Tant que ces deux variables sont absentes, le paiement reste en mode
#     démonstration (séquestre simulé). Dès qu'elles sont définies, le flux
#     réel Konnect prend le relais automatiquement.
# KONNECT_API_KEY="ta_cle_x_api_key"
# KONNECT_RECEIVER_WALLET_ID="ton_receiver_wallet_id"
#
# URL de l'API — sandbox par défaut. Production : https://api.konnect.network/api/v2
# KONNECT_API_URL="https://api.sandbox.konnect.network/api/v2"
#
# ⚠️  Le webhook Konnect appelle SITE_URL/api/payments/konnect/webhook : en dev
#     local, Konnect ne joint pas http://localhost — la page de retour
#     ?konnect=success règle le paiement en filet de sécurité. En prod, exposer
#     un SITE_URL public en HTTPS.
