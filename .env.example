# Copier ce fichier vers `.env` puis ajuster les valeurs.
# ⚠️  NE JAMAIS COMMITER `.env` — ce fichier doit rester dans .gitignore.

# ────────────────────────────────────────────────
# BASE DE DONNÉES — PostgreSQL (production-ready)
# ────────────────────────────────────────────────
# Dev local avec Docker :
#   docker run -d -p 5432:5432 \
#     -e POSTGRES_DB=darna -e POSTGRES_USER=darna -e POSTGRES_PASSWORD=darna \
#     --name darna-db postgres:16-alpine
DATABASE_URL="postgresql://darna:darna@localhost:5432/darna"

# Connexion DIRECTE utilisée par `prisma migrate` / `db push`. En local/démo
# (pas de pooler) elle est égale à DATABASE_URL — l'expansion ci-dessous suffit :
DIRECT_URL="${DATABASE_URL}"

# Production (Supabase / Railway / Neon / RDS) :
# Faire pointer DATABASE_URL sur le POOLER (PgBouncer en mode transaction) et
# dimensionner le pool via les paramètres d'URL ; DIRECT_URL pointe la connexion
# directe (port 5432) pour les migrations.
#   DATABASE_URL="postgresql://user:pwd@pooler-host:6543/darna?pgbouncer=true&connection_limit=10&pool_timeout=20&sslmode=require"
#   DIRECT_URL="postgresql://user:pwd@db-host:5432/darna?sslmode=require"

# ────────────────────────────────────────────────
# NEXTAUTH — Secret de session JWT
# ────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
# ⚠️  Ne JAMAIS réutiliser entre environnements (dev ≠ staging ≠ prod)
AUTH_SECRET="remplacez-moi-par-un-secret-aleatoire-openssl-rand-base64-32"

# ────────────────────────────────────────────────
# SITE — URL canonique (SEO, sitemap, HSTS)
# ────────────────────────────────────────────────
SITE_URL="https://darna.tn"
# Dev local :
# SITE_URL="http://localhost:3000"

# ════════════════════════════════════════════════
# MODES DÉMO ↔ PRODUCTION (cf. src/lib/modes.ts)
# ════════════════════════════════════════════════
# Tous les modes ont un défaut DÉMO sûr : l'app démarre sans aucune clé.
# Chaque mode réel exige sa config complète, VALIDÉE AU BOOT (fail-fast) — il
# est donc impossible d'activer une demi-prod par erreur.
#
#   PAYMENT_MODE = "demo" (séquestre simulé, défaut) | "konnect" (paiement réel)
#   KYC_MODE     = "demo" (OTP affiché, statut DEMO_VERIFIE, défaut) | "production"
#   STORAGE_MODE = "local" (disque, défaut) | "s3"
#   WEATHER_MODE = repli saisonnier (défaut) | "live" (Open-Meteo, gratuit/sans clé)
#
# DÉMO (réglages par défaut, rien à poser) :
# PAYMENT_MODE="demo"
# KYC_MODE="demo"
# STORAGE_MODE="local"
# Météo destination : repli saisonnier statique (aucun appel réseau) par défaut.
# Passer en réel (Open-Meteo, gratuit, sans clé) en pré-prod :
# WEATHER_MODE="live"

# ────────────────────────────────────────────────
# VERTICALES (feature flags par module — cf. src/lib/modes.ts)
# Les deux verticales sont ACTIVES par défaut (démo complète). Seule la valeur
# "false" désactive une verticale (nav, routes et création masquées / 404).
# Les deux ne peuvent pas valoir "false" en même temps (garde au boot).
# Permet un déploiement mono-verticale par simple config (split physique futur).
#   STAY_ENABLED = verticale Séjours (réservation + escrow)
#   IMMO_ENABLED = verticale Immo (location / vente, contact, jamais de paiement)
# STAY_ENABLED="true"
# IMMO_ENABLED="true"

# ────────────────────────────────────────────────
# PROXY — Trust du header IP (rate limiting)
# ────────────────────────────────────────────────
# Passer à "true" uniquement si le serveur est derrière un proxy de confiance
# (Vercel, Cloudflare, Nginx) qui pose x-real-ip correctement.
# ⚠️  En PRODUCTION RÉELLE (un mode réel actif ci-dessus), "true" est OBLIGATOIRE :
#     le boot échoue sinon (sans proxy, le rate limiting retombe sur un bucket
#     global « untrusted » → lockout de toute la plateforme).
# En dev local et en démo, laisser à "false".
TRUSTED_PROXY="false"

# ────────────────────────────────────────────────
# REDIS — Cache + rate limiting distribués (OPTIONNEL)
# ────────────────────────────────────────────────
# Absent ⇒ fallback in-memory mono-instance (OK démo / serveur unique).
# À définir en prod multi-instance (Upstash, Railway, Redis managé…) pour un
# rate limiting et un cache partagés entre toutes les instances.
# REDIS_URL="rediss://default:password@host:6379"
# Dev local avec Docker :
#   docker run -d -p 6379:6379 --name darna-redis redis:7-alpine
# REDIS_URL="redis://localhost:6379"

# ────────────────────────────────────────────────
# STOCKAGE IMAGES — local (défaut) ou S3/R2
# ────────────────────────────────────────────────
# STORAGE_MODE="local" par défaut (uploads sur /public/uploads, serveur
# persistant requis — NE convient PAS au multi-instance/serverless).
# Passer à "s3" pour Cloudflare R2 / AWS S3 / MinIO — les 4 premières variables
# deviennent alors OBLIGATOIRES (boot fail-fast).
# (Rétro-compat : l'ancien STORAGE_DRIVER="s3" reste reconnu.)
# STORAGE_MODE="s3"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_BUCKET="darna-uploads"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_REGION="auto"                       # "auto" pour R2 ; ex. "eu-west-1" pour AWS
# S3_PUBLIC_URL="https://cdn.darna.tn"   # base publique de service (déf. : endpoint/bucket)

# ────────────────────────────────────────────────
# KYC — Vérification d'identité
# ────────────────────────────────────────────────
# KYC_MODE="demo" (défaut) : OTP affiché à l'écran, aucun SMS, statut DEMO_VERIFIE
#   (badge « démo » distinct, jamais confondu avec une vérification réelle).
# KYC_MODE="production" : exige (boot fail-fast) KYC_ENC_KEY + SMS_PROVIDER, ne
#   retourne JAMAIS le code au client, statut VERIFIE réservé au workflow SMS réel.
# KYC_MODE="production"
#
# Chiffrement AES-256-GCM de la CIN au repos. Générer : openssl rand -hex 32.
# Absent en démo → CIN en clair (CIN de démo). OBLIGATOIRE dès KYC_MODE=production.
# KYC_ENC_KEY="..."
#
# Provider SMS réel (implémenté dans src/lib/sms.ts). Requis dès KYC_MODE=production.
# Sert AUSSI de repli SMS quand OTP_PROVIDER=meta-whatsapp et que WhatsApp échoue.
# Seule valeur câblée pour l'instant : "twilio".
# SMS_PROVIDER="twilio"
#
# Identifiants Twilio — requis (boot fail-fast) dès SMS_PROVIDER=twilio.
# Console : https://console.twilio.com (Account SID + Auth Token).
# TWILIO_FROM : numéro expéditeur au format E.164 (ex. "+12025550123") OU un
#   Messaging Service SID (préfixe "MG…") si tu utilises un Messaging Service.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM="+1..."

# ────────────────────────────────────────────────
# OBSERVABILITÉ — Capture des erreurs (OPTIONNEL)
# ────────────────────────────────────────────────
# Les erreurs serveur sont TOUJOURS loggées en JSON structuré (stdout, captées
# par onRequestError). Si défini, elles sont aussi POSTées vers cet endpoint
# (relais Sentry, Slack, Logtail HTTP…). Absent → log seul.
# OBSERVABILITY_WEBHOOK_URL="https://..."

# ────────────────────────────────────────────────
# L3.1 — SCHEDULER — /api/jobs/tick (LANCEMENT_ROADMAP.md)
# ────────────────────────────────────────────────
# Secret du endpoint de tick appelé par Vercel Cron (vercel.json, toutes les
# 15 min). Vercel envoie automatiquement `Authorization: Bearer $CRON_SECRET`
# quand la variable est définie sur le projet Vercel — rien à câbler côté
# Vercel. Requis (boot fail-fast) dès qu'un mode réel est actif
# (PAYMENT_MODE=konnect / KYC_MODE=production / STORAGE_MODE=s3).
# Absent en démo par défaut → l'endpoint répond 401 à tout appel (normal,
# aucun job réel ne tourne encore en démo).
# CRON_SECRET="openssl-rand-base64-32"
#
# Test manuel en local (le cron Vercel n'existe pas en dev) :
#   curl -H "Authorization: Bearer $CRON_SECRET" http://localhost:3000/api/jobs/tick

# ────────────────────────────────────────────────
# CAPTCHA — Cloudflare Turnstile (OPTIONNEL, anti-robot auth)
# ────────────────────────────────────────────────
# Défaut : absent / "off" → aucun CAPTCHA, aucune friction en démo.
# "turnstile" → widget sur inscription + connexion, vérifié côté serveur.
# Exige (boot fail-fast) les DEUX clés ci-dessous. Sandbox/clés gratuites :
# https://dash.cloudflare.com/?to=/:account/turnstile
# La SITE KEY est publique (préfixe NEXT_PUBLIC_) ; le SECRET reste serveur only.
# ⚠️ Avant prod : remplacer d'éventuelles clés de TEST par les vraies clés du site.
# CAPTCHA_MODE="turnstile"
# TURNSTILE_SECRET_KEY="0x..."
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."

# ────────────────────────────────────────────────
# KONNECT — Paiement & séquestre
# ────────────────────────────────────────────────
# Sandbox gratuit, sans entité : https://dashboard.sandbox.konnect.network
# Récupérer dans le dashboard : la clé API (x-api-key) + le receiverWalletId.
#
# ⚠️  Le paiement réel ne s'active QU'AVEC PAYMENT_MODE="konnect" (cf. section
#     MODES) — la simple présence des clés ne suffit plus (anti-activation
#     accidentelle d'un paiement réel). En PAYMENT_MODE=konnect, ces deux
#     variables sont OBLIGATOIRES (boot fail-fast).
# PAYMENT_MODE="konnect"
# KONNECT_API_KEY="ta_cle_x_api_key"
# KONNECT_RECEIVER_WALLET_ID="ton_receiver_wallet_id"
#
# URL de l'API — sandbox par défaut. Production : https://api.konnect.network/api/v2
# KONNECT_API_URL="https://api.sandbox.konnect.network/api/v2"
#
# ⚠️  Le webhook Konnect appelle SITE_URL/api/payments/konnect/webhook : en dev
#     local, Konnect ne joint pas http://localhost — la page de retour
#     ?konnect=success règle le paiement en filet de sécurité. En prod, exposer
#     un SITE_URL public en HTTPS.
#
# Authenticité du webhook : Konnect NE signe PAS ses appels. Darna signe donc
# elle-même l'URL de webhook (HMAC du bookingId) et la revérifie à la réception.
# Par défaut, la clé est dérivée d'AUTH_SECRET → rien à configurer. Pour une
# rotation indépendante du secret d'auth, poser une clé dédiée (≥16 car.) :
# KONNECT_WEBHOOK_SECRET="openssl-rand-base64-32"

# ────────────────────────────────────────────────
# PR3 — KYC GATING — Publication d'annonces
# ────────────────────────────────────────────────
# Défaut : absent / "off" → pas de blocage (démo complète sans config).
# "on" → seuls les utilisateurs vérifiés (VERIFIE ou DEMO_VERIFIE) peuvent
#          publier une annonce.
# KYC_GATING="on"

# ────────────────────────────────────────────────
# PR4 — OTP MULTI-CANAL — WhatsApp Business API
# ────────────────────────────────────────────────
# Défaut : absent / "sms" → comportement historique (SMS via SMS_PROVIDER).
# "meta-whatsapp" → envoi via WhatsApp Cloud API (Meta).
#   Requis si OTP_PROVIDER=meta-whatsapp (boot fail-fast) — un token ET un phone id,
#   sous les noms historiques OU les alias de la checklist Meta (l'un OU l'autre) :
#     Token    : META_WHATSAPP_ACCESS_TOKEN  | alias META_WABA_TOKEN
#     Phone id : META_WHATSAPP_PHONE_ID      | alias META_WABA_PHONE_NUMBER_ID
#   Template (optionnel, défauts authentication / fr) :
#     META_WA_TEMPLATE_NAME, META_WA_TEMPLATE_LANG
# OTP_PROVIDER="meta-whatsapp"
# META_WHATSAPP_ACCESS_TOKEN="EAAxxxxxxxx..."   # ou META_WABA_TOKEN="EAAxxxxxxxx..."
# META_WHATSAPP_PHONE_ID="1234567890"           # ou META_WABA_PHONE_NUMBER_ID="1234567890"
# META_WA_TEMPLATE_NAME="authentication"
# META_WA_TEMPLATE_LANG="fr"
# META_GRAPH_API_VERSION="v21.0"   # optionnel — pour migrer de version sans déployer
#
# Checklist passage en PRODUCTION (OTP WhatsApp) :
#   1. Portefeuille business VÉRIFIÉ + template d'authentification APPROUVÉ.
#   2. Token PERMANENT d'un System User (pas le token temporaire 24 h du sandbox).
#   3. META_WA_TEMPLATE_NAME / _LANG = nom + langue exacts du template approuvé.
#   4. KYC_MODE="production" pour décerner le vrai badge VERIFIE (et non DEMO_VERIFIE).
#   Le numéro saisi par l'hôte est normalisé automatiquement (indicatif + numéro).

# ────────────────────────────────────────────────
# PR5 — VÉRIFICATION E-MAIL — Resend
# ────────────────────────────────────────────────
# Défaut : absent / "demo" → aucun envoi, code affiché à l'écran.
# "resend" → envoi via l'API Resend (RESEND_API_KEY requis, boot fail-fast).
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# EMAIL_FROM="Darna <noreply@darna.tn>"

# ────────────────────────────────────────────────
# CAPTCHA ANTI-ROBOT — Cloudflare Turnstile
# ────────────────────────────────────────────────
# Défaut : absent / "off" → aucun CAPTCHA, aucune friction (démo).
# "turnstile" → widget sur l'inscription ET la connexion + vérification serveur.
# Gratuit, respectueux de la vie privée. Crée un widget sur dash.cloudflare.com
# (Turnstile) pour obtenir les deux clés. Les deux sont requises (boot fail-fast).
# La SITE KEY est publique (NEXT_PUBLIC_) ; le SECRET reste côté serveur.
# CAPTCHA_MODE="turnstile"
# TURNSTILE_SECRET_KEY="0x4AAAAAAA..."
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
